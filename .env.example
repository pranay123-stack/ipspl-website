# ---------------------------------------------------------------------------
# IPS-PL — environment variables
# Copy to .env.local for development. Every variable is optional locally:
# without them the site runs, emails log to the console and analytics is off.
# ---------------------------------------------------------------------------

# --- Email (Resend) --------------------------------------------------------
# Without RESEND_API_KEY, enquiries are logged to the server console instead
# of being sent, so the form can be exercised end to end in development.
RESEND_API_KEY=
# Must be a domain verified in Resend. Use a subdomain so SPF/DKIM records do
# not touch the existing ips-pl.com mail flow.
RESEND_FROM="IPS-PL Enquiries <enquiries@mail.ips-pl.com>"
# Where internal enquiry notifications are delivered.
SALES_INBOX_EMAIL=sales@ips-pl.com

# --- Rate limiting (Upstash Redis) -----------------------------------------
# Omit both and the site falls back to a per-process in-memory limiter: real
# protection against a naive script, none against a distributed one, because
# each serverless instance keeps its own counters. Both are required in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (Plausible) -------------------------------------------------
# Leave blank in development. Setting it enables the cookieless tag, proxied
# through /js/script.js so ad blockers do not remove it.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Bot challenge (Cloudflare Turnstile) ----------------------------------
# Both halves or neither. Unset, the widget does not render and the server
# skips verification, so the form works exactly as it does today. Set both and
# a solved challenge becomes a precondition for delivery — no code change.
# Create a widget at dash.cloudflare.com -> Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Delivery failure alerts -----------------------------------------------
# Any endpoint accepting {"text": "..."} — a Slack or Teams incoming webhook.
# Unset, failures are logged only, which means nobody finds out. A failed
# enquiry is a lost customer; this is how you hear about it.
ALERT_WEBHOOK_URL=

# ===========================================================================
# PUBLIC CONTENT — safe to expose, read at BUILD time
# ---------------------------------------------------------------------------
# Everything prefixed NEXT_PUBLIC_ is inlined into the pages when the site is
# built, not read when a visitor loads it. Changing one takes effect on the
# next deploy, not immediately — but it can be changed in the hosting
# dashboard instead of in the source, which is the point.
#
# Every URL below is validated. A malformed value is treated as absent, so a
# typo hides the link rather than publishing one that goes nowhere.
# ===========================================================================

# --- Scheduling ------------------------------------------------------------
# Calendly, Cal.com, or anything that opens in a browser. Unset, the
# "Book a call" button does not render at all.
# MUST be IPS-PL's own account before launch, not a developer's.
NEXT_PUBLIC_BOOKING_URL=

# --- Social / profiles -----------------------------------------------------
# LinkedIn drives the footer link AND Organization.sameAs in structured data,
# which is a primary input to Google's knowledge panel. Cheapest SEO win here.
NEXT_PUBLIC_LINKEDIN_URL=
# Google Business Profile drives the Directions link on /contact and also
# joins sameAs.
NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE=

# --- Published contact details ---------------------------------------------
# Shown on the site. Each has a built-in fallback, so leaving these blank
# renders the current published details rather than a gap.
# NOTE: NEXT_PUBLIC_SALES_EMAIL is what visitors SEE. Where enquiry email is
# actually DELIVERED is SALES_INBOX_EMAIL above — they can differ.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SALES_EMAIL=
# Comma-separated, in display order.
NEXT_PUBLIC_PHONES=

# --- Contact page map -------------------------------------------------------
# A Google Maps embed URL for the Vadodara works. Unset, /contact shows the
# address and no iframe — which costs nothing and never renders broken. Set it
# and a "Show map" button appears; the iframe still only loads on click, so it
# never touches first paint. Setting this also widens frame-src in the CSP.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# --- Content Security Policy -----------------------------------------------
# The policy ships as Content-Security-Policy-Report-Only with violations
# posted to /api/csp-report. Set to 1 to enforce it, after watching the
# reports on real traffic. See PRE-LAUNCH.md.
CSP_ENFORCE=

# --- Testing ---------------------------------------------------------------
# Set only by the Playwright suite. Writes each outbound email to this
# directory as JSON instead of sending, so a test can assert what was
# delivered. Ignored whenever RESEND_API_KEY is present.
EMAIL_CAPTURE_DIR=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.ips-pl.com
